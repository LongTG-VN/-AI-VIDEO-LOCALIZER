# Copy this file to .env and fill only the providers you intend to use.
# Never commit the resulting .env file.

OLLAMA_API_BASE=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

GEMINI_API_KEY=
GEMINI_FREE_MODEL_FLASH=gemini-2.5-flash

GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_FREE_MODEL_8B=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_FREE_GEMINI=google/gemini-2.5-flash:free

CEREBRAS_API_KEY=
CEREBRAS_API_BASE=https://api.cerebras.ai/v1
CEREBRAS_FREE_MODEL=llama3.1-8b

SAMBANOVA_API_KEY=
SAMBANOVA_API_BASE=https://api.sambanova.ai/v1
SAMBANOVA_FREE_MODEL=Meta-Llama-3.3-70B-Instruct

GITHUB_TOKEN=
GITHUB_MODELS_BASE=https://models.inference.ai.azure.com
GITHUB_FREE_MODEL=gpt-4o

OMNIROUTE_URL=http://localhost:20128/v1
LITELLM_URL=http://localhost:4000/v1

LLM_TIMEOUT=30
LLM_RETRY=2

# Required by agent_framework/router.py.
ROUTER_API_TOKEN=replace-with-a-random-local-token
ROUTER_ALLOWED_ORIGIN=
ROUTER_MAX_BODY_BYTES=1048576
ROUTER_MAX_RESPONSE_BYTES=8388608
