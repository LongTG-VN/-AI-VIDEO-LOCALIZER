APP_NAME=AI Video Localizer
DATA_DIR=./data
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Safe baseline. Enable the real engines after the machine-specific runtimes are ready.
ASR_ENGINE=mock
OCR_ENGINE=none

FUNASR_MODEL=paraformer-zh
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_SPK_MODEL=cam++
FUNASR_DEVICE=cpu

# Subtitle OCR sampling / ROI used by Phase 4+.
OCR_FPS=2.0
OCR_CROP_TOP_RATIO=0.65
OCR_CROP_BOTTOM_RATIO=0.95
OCR_CROP_LEFT_RATIO=0.06
OCR_CROP_RIGHT_RATIO=0.94
OCR_CHANGE_DIFF_THRESHOLD=16.0

# OpenAI-compatible chat/completions endpoint used for context + translation.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
